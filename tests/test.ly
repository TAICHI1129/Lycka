c("Lycka 動作確認テスト")
c("各チェックは 'ok ...' か 'FAIL ...' を1行表示する。FAIL が1つでもあれば不合格。")
c("Go 側(tests/run_test.go)がこのファイルを実行して FAIL の有無と ok の数を検証する。")

c("===== 変数: set / to =====")
set("x") to(10)
if(x = 10)(print("ok set/to")) else(print("FAIL set/to"))
set("x") to(99)
to(20)
if(x = 20)(print("ok to targets the latest set")) else(print("FAIL to targets the latest set"))
set("x")
if(x = 20)(print("ok set on existing variable keeps value")) else(print("FAIL set on existing variable keeps value"))
set("fresh")
if(fresh = null)(print("ok set without to is null")) else(print("FAIL set without to is null"))
set("z") to(1) set("w") to(2)
if(z + w = 3)(print("ok several calls on one line")) else(print("FAIL several calls on one line"))

c("===== int 演算 =====")
if(1 + 2 = 3)(print("ok int +")) else(print("FAIL int +"))
if(5 - 7 = -2)(print("ok int - and unary minus")) else(print("FAIL int - and unary minus"))
if(10 ÷ 3 = 3)(print("ok int division truncates")) else(print("FAIL int division truncates"))
if(1 + 4 ÷ 2 = 3)(print("ok ÷ binds tighter than +")) else(print("FAIL ÷ binds tighter than +"))
if((1 + 4) ÷ 5 = 1)(print("ok grouping parentheses")) else(print("FAIL grouping parentheses"))
if(123456789012345678901234567890 + 1 = 123456789012345678901234567891)(print("ok arbitrary precision int")) else(print("FAIL arbitrary precision int"))

c("===== str 演算 =====")
if("ab" + "cd" = "abcd")(print("ok str +")) else(print("FAIL str +"))
if("abcd" - "bc" = "ad")(print("ok str -")) else(print("FAIL str -"))
if('single' = "single")(print("ok both quote styles")) else(print("FAIL both quote styles"))

c("===== list 演算 =====")
if(list[1, 2] + list[2, 3] = list[1, 2, 3])(print("ok list + merges duplicates")) else(print("FAIL list + merges duplicates"))
if(list[1, 2, 2] + list[2] = list[1, 2])(print("ok list + dedupes within one list")) else(print("FAIL list + dedupes within one list"))
if(list[1, 2, 3] - list[2] = list[1, 3])(print("ok list -")) else(print("FAIL list -"))
if(list[3, 1, 2] = list[1, 2, 3])(print("ok list = ignores order")) else(print("FAIL list = ignores order"))
if(list[1, 2] = list[1, 2, 3])(print("FAIL list = needs both directions")) else(print("ok list = needs both directions"))
if(list[1, 2, 3] = 2)(print("ok list = scalar when contained")) else(print("FAIL list = scalar when contained"))
if(list[1, 2, 3] = 5)(print("FAIL list = scalar when absent")) else(print("ok list = scalar when absent"))
if(list[1, "a", TRUE, null] = "a")(print("ok list holds mixed types")) else(print("FAIL list holds mixed types"))
if(list[] = list[])(print("ok empty lists are equal")) else(print("FAIL empty lists are equal"))

c("===== bl / null =====")
if(TRUE = TRUE)(print("ok bl = bl")) else(print("FAIL bl = bl"))
if(TRUE = FALSE)(print("FAIL TRUE = FALSE")) else(print("ok TRUE = FALSE is FALSE"))
if(null = null)(print("ok null = null")) else(print("FAIL null = null"))
if(null + null = null)(print("ok null + null")) else(print("FAIL null + null"))
if(1 = "1")(print("FAIL different types are not equal")) else(print("ok different types are not equal"))

c("===== cd 型 =====")
set("code") to(cd[print("ok cd stored in a variable")])
if(TRUE)(code)
set("code2") to(cd[print("ok cd concat part 1")] + cd[print("ok cd concat part 2")])
if(TRUE)(code2)
if(TRUE)(cd[print("ok explicit cd[] argument")])

c("===== if / else =====")
if(FALSE)(print("FAIL if skips on FALSE"))
else(print("ok else runs after FALSE"))
if(TRUE)(print("ok if runs on TRUE"))
else(print("FAIL else skipped after TRUE"))
set("flag") to(0)
if(TRUE)(if(FALSE)(print("FAIL inner if ran")))
else(set("flag") to(1))
if(flag = 0)(print("ok else pairs with the outer if")) else(print("FAIL else pairs with the outer if"))
if(FALSE)(print("FAIL")) print("ok unrelated call between if and else") else(print("ok else after an unrelated call"))

c("===== while =====")
set("i") to(3)
while(i = 0 = FALSE)(set("i") to(i - 1))
if(i = 0)(print("ok while counts down")) else(print("FAIL while counts down"))
set("n") to(3)
set("sum") to(0)
while(n = 0 = FALSE)(set("sum") to(sum + n) set("n") to(n - 1))
if(sum = 6)(print("ok while re-evaluates its condition")) else(print("FAIL while re-evaluates its condition"))
while(FALSE)(print("FAIL while body must not run"))
print("ok while with FALSE never runs")

c("===== smthng =====")
set("s") to(0 ÷ 0)
if(isitsth(s))(print("ok 0 ÷ 0 is smthng")) else(print("FAIL 0 ÷ 0 is smthng"))
if(isitsth(s = s))(print("ok smthng = smthng is smthng")) else(print("FAIL smthng = smthng is smthng"))
if(isitsth(1))(print("FAIL int is not smthng")) else(print("ok int is not smthng"))
if(isitsth(null))(print("FAIL null is not smthng")) else(print("ok null is not smthng"))
if(isitsth(list[s]))(print("FAIL list of smthng is a list")) else(print("ok list of smthng is a list"))
if(isitsth(s + s))(print("ok smthng + smthng is smthng")) else(print("FAIL smthng + smthng is smthng"))
if(isitsth(s - s))(print("ok smthng - smthng is smthng")) else(print("FAIL smthng - smthng is smthng"))
if(isitsth(1 = s))(print("ok comparing with smthng is smthng")) else(print("FAIL comparing with smthng is smthng"))
c("条件が smthng のとき、if も else も実行されない")
if(s = s)(print("FAIL smthng condition took the TRUE branch"))
else(print("FAIL smthng condition took the FALSE branch"))
print("ok smthng condition takes neither branch")
c("while の条件が smthng ならループは終わる")
while(s = s)(print("FAIL smthng while condition looped"))
print("ok smthng while condition stops")

c("===== concur =====")
concur(set("ca") to(1))(set("cb") to(2))(set("cc") to(3))
if(ca + cb + cc = 6)(print("ok concur runs every branch")) else(print("FAIL concur runs every branch"))
set("total") to(0)
concur(set("t1") to(1) set("t2") to(t1 + 1))(set("t3") to(10))
if(t1 + t2 + t3 = 13)(print("ok concur branches keep their own set/to")) else(print("FAIL concur branches keep their own set/to"))

c("===== コメント c() =====")
c(print("FAIL a comment was executed"))
c("a")("b")(1)(list[1, 2])(cd[print("FAIL comment cd executed")])
print("ok comments are removed before execution")
